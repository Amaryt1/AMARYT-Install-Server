{
  "name": "amaryt-direct-install-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env dist/server.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "bplist-parser": "^0.3.2",
    "fastify": "^5.12.8",
    "ipaddr.js": "^2.5.0",
    "plist": "^3.1.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@types/node": "^22.20.5",
    "@types/plist": "^3.0.5",
    "@types/yauzl": "^2.10.3",
    "fflate": "^0.8.3",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
